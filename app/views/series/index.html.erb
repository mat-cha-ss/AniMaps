<h1>Anime</h1>

<%= link_to "Import MyAnimeList", mal_import_path %>

<table>
  <thead>
    <tr>
      <th>Series</th>
      <th>Locations</th>
      <th>Events</th>
    </tr>
  </thead>

  <tbody>
    <% @series.each do |series| %>
      <% user_animes = series.animes.joins(:user_animes).where(user_animes: { user_id: Current.user.id }).distinct %>
      <tr>
        <td><%= series.official_title("en") %></td>
        <td>
        <%= link_to(
          user_animes.joins(:locations).distinct.count("locations.id"),
          anime_series_locations_path(series)
        ) %>
        </td>
        <td>
        <%= link_to(
          user_animes.joins(:events).distinct.count("events.id"),
          anime_series_events_path(series)
        ) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>